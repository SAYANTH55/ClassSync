# ClassSync backend configuration — copy to `.env` and fill in real values.
# NEVER commit a real .env (it is git-ignored). Placeholders only below.

# ---- authentication (demo login) ------------------------------------------
# The single demo account. If CLASSSYNC_PASSWORD is unset, the backend falls
# back to the built-in demo password hash (no plaintext in source).
CLASSSYNC_USERNAME=your_username
CLASSSYNC_PASSWORD=your_password

# Secret used to sign the session cookie. Use a long random string in
# production so sessions stay valid across restarts / multiple workers.
CLASSSYNC_SECRET=change_me_to_a_long_random_hex_string

# Set to 1 in production (HTTPS) so the session cookie is marked Secure.
# Keep 0 for local http testing, otherwise the cookie won't be sent.
CLASSSYNC_SECURE_COOKIE=0

# ---- models (deployment) ---------------------------------------------------
# Where insightface stores/downloads the buffalo_l models. Defaults to
# <project>/models/insightface when unset.
# INSIGHTFACE_ROOT=/app/models/insightface
